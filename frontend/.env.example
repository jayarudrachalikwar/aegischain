# AegisChain frontend configuration (copy to .env; .env is git-ignored)

# Demo mode (default): UI runs on an in-browser mock store with SIMULATED login, MFA, encryption and
# ledger. It never contacts the backend. Set to "false" to call the real API (not fully mapped to the
# API contract yet; see docs/FRONTEND_INTEGRATION.md).
VITE_DEMO_MODE=true

# Real mode only. Default is same-origin /api/v1 via the Vite dev proxy (no CORS, cookie stays first-party).
# VITE_API_BASE_URL=/api/v1
# Dev proxy target for /api (backend). Use 3100 if port 3000 is busy on your machine.
# VITE_PROXY_TARGET=http://localhost:3000
