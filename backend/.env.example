# Copy to backend/.env for local development (backend/.env is git-ignored).
# Real environment variables take precedence over this file.
# Secrets are read from files generated by `node infra/scripts/gen-secrets.mjs`; never paste secret values here.
NODE_ENV=development
PORT=3000
DATABASE_URL_FILE=../infra/secrets/database_url
AEGIS_KEK_V1_FILE=../infra/secrets/aegis_kek_v1
MINIO_ENDPOINT=http://localhost:9000
# 'memory' is rejected when NODE_ENV=production (SR-22)
LEDGER_DRIVER=memory
